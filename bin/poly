#!/usr/bin/env bash
# poly — a thin spago wrapper for the polyglot-template B layout.
#
# A column is one lowering of core/ (docs/TWO-AXES.md): a RUNTIME (execute the
# program: node/jurist/go) or an INTERPRETER (fold the value: docs/nix). The
# structure carries most of it (pace Jameson): each columns/<col>/spago.yaml
# already pins the package set + backend, so `spago build` in a column does the
# right first step. poly only adds the per-column lower + run/emit glue that
# spago can't express, and discovers which columns a project has.
#
#   poly list             which columns this project has, and are their backends found
#   poly run <col>        build + run/emit one column       (col = a columns/<col> dir)
#   poly run all          run every column; summarise pass/fail
#   poly build <col>      produce the deliverable artifact (binary for go, .nix for nix)
#
# Backend binaries resolve per column: $PUREJL/$PSGO/$PURSNIX env override first,
# then PATH, then the sibling purescript-backends repos. Run from anywhere in a
# project; poly walks up to the dir that contains columns/.
set -uo pipefail

# --- find project root (nearest ancestor with a columns/ dir) ---
root() { local d="$PWD"; while [ "$d" != / ]; do [ -d "$d/columns" ] && { echo "$d"; return; }; d=$(dirname "$d"); done; return 1; }
ROOT=$(root) || { echo "poly: not inside a project (no columns/ dir found above $PWD)" >&2; exit 1; }

# locate the sibling purescript-backends repo (walk up from the project)
find_backends() { local d="$ROOT"; while [ "$d" != / ]; do [ -d "$d/purescript-backends" ] && { echo "$d/purescript-backends"; return; }; d=$(dirname "$d"); done; }
BACKENDS=${POLY_BACKENDS:-$(find_backends)}

# --- resolve a backend binary: env var > PATH > sibling .stack-work ---
resolve() { # $1=binname $2=backend-repo-dir
  local bin=$1 repo=$2 ev; ev=$(echo "$bin" | tr '[:lower:]' '[:upper:]')
  [ -n "${!ev:-}" ] && { echo "${!ev}"; return; }
  command -v "$bin" >/dev/null 2>&1 && { command -v "$bin"; return; }
  [ -n "$BACKENDS" ] && find "$BACKENDS/$repo" -path '*/bin/'"$bin" -type f 2>/dev/null | head -1 | grep . || return 1
}

# --- the per-column adapter registry. Add a lowering = add a case arm. ---
# A column is one lowering of core/ (see docs/TWO-AXES.md). Two populations:
#   RUNTIME columns (node/jurist/go) — an EXECUTION; core is the program, the
#     per-runtime foreign sits co-located at the seam.
#   INTERPRETER columns (docs/nix)  — an EMIT; core is a value, the column
#     folds it. Its backend may be a spago backend (docs=JS) OR a post-CoreFn
#     compiler (nix=Nyx/pursnix, structurally the twin of the go arm).
# `run` executes/emits-and-shows; `build` produces the deliverable artifact.
# do_column <col> <build|run> : in columns/<col>, spago build then lower (+run)
do_column() {
  local rt=$1 mode=$2 bin col
  col="$ROOT/columns/$rt"
  [ -d "$col" ] || { echo "poly: no column 'columns/$rt'" >&2; return 2; }
  ( cd "$col" || exit 1
    spago build >/tmp/poly-spago.$$ 2>&1 || { echo "  spago build FAILED:"; tail -5 /tmp/poly-spago.$$; rm -f /tmp/poly-spago.$$; exit 1; }
    rm -f /tmp/poly-spago.$$
    case "$rt" in
      node|docs)
        # JS backend. A node RUNTIME runs its Main; a text INTERPRETER (docs)
        # is the same mechanism — a Main that prints the emitted artifact.
        [ "$mode" = build ] && { echo "  built: output/ (run with node)"; exit 0; }
        node --input-type=module -e 'import("./output/Main/index.js").then(m=>m.main())' ;;
      erlang|erl)
        # purerl. purs-backend-erl ran during `spago build` (the column's
        # backend.cmd), into a NESTED output-erl/<Module>/ tree. Two lessons from
        # purerl-tidal's engine (docs/FIELD-REPORTS.md): erlc ONE FILE AT A TIME,
        # since a batched erlc stops at the first failure and leaves the rest
        # unbuilt; and -disable-feature maybe_expr, since OTP 27 made `maybe` a
        # keyword and purerl's Data.Maybe defines a function of that name. Any
        # erlc error stops the column: a module that failed to compile is
        # otherwise `undef` only at run time, far from its cause.
        mkdir -p ebin
        local f fail=0
        while IFS= read -r f; do
          erlc -disable-feature maybe_expr -o ebin "$f" >/tmp/poly-erlc.$$ 2>&1 \
            || { echo "  erlc FAILED: $f"; grep -v Warning /tmp/poly-erlc.$$ | head -5; fail=1; }
        done < <(find output-erl -name '*.erl')
        rm -f /tmp/poly-erlc.$$
        [ "$fail" = 0 ] || exit 1
        [ "$mode" = build ] && { echo "  built: ebin/ (run with erl -pa ebin)"; exit 0; }
        erl -pa ebin -noshell -eval 'F = main@ps:main(), F()' -s init stop ;;
      jurist|julia)
        bin=$(resolve purejl purescript-julia) || { echo "  purejl not found (set \$PUREJL)"; exit 3; }
        "$bin" output output-jl >/dev/null || exit 1
        [ "$mode" = build ] && { echo "  built: output-jl/ (run with julia output-jl/main.jl)"; exit 0; }
        julia output-jl/main.jl ;;
      go|gnomon)
        bin=$(resolve psgo purescript-go) || { echo "  psgo not found (set \$PSGO)"; exit 3; }
        "$bin" output output-go --entry Main >/dev/null || exit 1
        if [ "$mode" = build ]; then ( cd output-go && go build -o "../$rt-bin" ./*.go ) && echo "  binary: columns/$rt/$rt-bin"
        else ( cd output-go && go run ./*.go ); fi ;;
      nix|nyx)
        # INTERPRETER column, post-CoreFn: the twin of the go arm. spago (backend
        # cmd:true) left CoreFn in output/; Nyx writes .nix back INTO output/<Mod>/
        # and resolves the co-located <Mod>.nix FFI against the column root (.).
        bin=$(resolve pursnix purescript-nix) || { echo "  pursnix not found (set \$PURSNIX, or build purescript-nix)"; exit 3; }
        "$bin" output . >/dev/null || exit 1
        local entry="${NIX_ENTRY:-ToNix.result}" mod val
        mod="${entry%%.*}"; val="${entry#*.}"
        if [ "$mode" = build ]; then echo "  emitted: columns/$rt/output/$mod/default.nix  (eval (import …/$mod).$val)"; exit 0
        else nix eval --impure --expr "(import ./output/$mod).$val"; fi ;;
      *) echo "poly: no adapter for column '$rt' (add a case arm in $0)" >&2; exit 4 ;;
    esac )
}

columns() { for d in "$ROOT"/columns/*/; do [ -d "$d" ] && basename "$d"; done; }

# --- local realizer (zero Nix): build + content-hash -> a pin manifest. ---
# The pin's shape (source + pin) matches Bosun's x-bosun.artifact; the hermetic
# Nix realizer slots in behind the SAME seam later (inputs become store paths).
hash_artifact() { # $1=path -> sha256 of a file, or content-tree hash of a dir
  if [ -f "$1" ]; then shasum -a 256 "$1" | awk '{print $1}'
  elif [ -d "$1" ]; then find "$1" -type f -exec shasum -a 256 {} + | awk '{print $1}' | sort | shasum -a 256 | awk '{print $1}'
  else echo MISSING; fi
}
artifact_of() { case "$1" in   # kind|relpath of the deliverable
  go|gnomon)    echo "file|columns/$1/$1-bin";;
  jurist|julia) echo "tree|columns/$1/output-jl";;
  node)         echo "tree|columns/$1/output";;
  erlang|erl)   echo "tree|columns/$1/ebin";;
  *)            echo "none|";; esac; }
pin_column() {
  local rt=$1 spec kind rel abs sha bytes backend bin rttool pset
  do_column "$rt" build >/dev/null 2>&1 || { echo "  build failed for $rt" >&2; return 1; }
  spec=$(artifact_of "$rt"); kind=${spec%%|*}; rel=${spec#*|}
  [ -n "$rel" ] || { echo "  no artifact mapping for $rt" >&2; return 1; }
  abs="$ROOT/$rel"; sha=$(hash_artifact "$abs")
  bytes=$(find "$abs" -type f -print0 2>/dev/null | xargs -0 wc -c 2>/dev/null | tail -1 | awk '{print $1}')
  case "$rt" in
    go|gnomon)    backend=psgo;   bin=$(resolve psgo purescript-go 2>/dev/null);    rttool=$(go version 2>/dev/null);;
    jurist|julia) backend=purejl; bin=$(resolve purejl purescript-julia 2>/dev/null); rttool=$(julia --version 2>/dev/null);;
    node)         backend=purs;   bin=$(command -v node 2>/dev/null);              rttool=$(node --version 2>/dev/null);;
  esac
  pset=$(grep -oE 'registry: *[0-9.]+' "$ROOT/columns/$rt/spago.yaml" 2>/dev/null | head -1 | tr -d ' ')
  mkdir -p "$ROOT/pins"
  cat > "$ROOT/pins/$rt.json" <<EOF
{
  "runtime": "$rt",
  "source":  { "project": "$(basename "$ROOT")", "column": "$rt", "entry": "Main" },
  "inputs":  {
    "purs": "$(purs --version 2>/dev/null)",
    "spago": "$(spago --version 2>/dev/null)",
    "packageSet": "${pset:-unknown}",
    "backend": "$backend",
    "backendBin": "${bin:-n/a}",
    "runtimeTool": "${rttool:-n/a}"
  },
  "artifact": { "kind": "$kind", "path": "$rel", "sha256": "$sha", "bytes": ${bytes:-0} },
  "builtAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "realizer": "local (zero-Nix): provenance + content hash. A hermetic Nix realizer slots in behind the same pin shape; inputs become store paths."
}
EOF
  echo "  pinned $rt -> pins/$rt.json  (sha256 ${sha:0:12}…, ${bytes:-?} bytes)"
}

cmd=${1:-list}; arg=${2:-}
case "$cmd" in
  list)
    echo "project: $ROOT"
    printf "%-10s %-8s %s\n" COLUMN BACKEND STATUS
    for rt in $(columns); do
      case "$rt" in
        node|docs)    b=purs;    s="ready (spago)";;
        erlang|erl)   b=purerl;  command -v erlc >/dev/null 2>&1 && s="ready (erlc)" || s="erlc not found";;
        jurist|julia) b=purejl;  resolve purejl purescript-julia >/dev/null 2>&1 && s=ready || s="purejl not found";;
        go|gnomon)    b=psgo;    resolve psgo  purescript-go    >/dev/null 2>&1 && s=ready || s="psgo not found";;
        nix|nyx)      b=pursnix; resolve pursnix purescript-nix >/dev/null 2>&1 && s=ready || s="pursnix not found";;
        *)            b="?";     s="no adapter";;
      esac
      printf "%-10s %-8s %s\n" "$rt" "$b" "$s"
    done ;;
  run)
    if [ "$arg" = all ] || [ -z "$arg" ]; then
      rc=0
      for rt in $(columns); do echo "== $rt =="; do_column "$rt" run || rc=1; done
      exit $rc
    else do_column "$arg" run; fi ;;
  build)
    [ -n "$arg" ] || { echo "usage: poly build <col>" >&2; exit 1; }
    do_column "$arg" build ;;
  pin)
    if [ "$arg" = all ] || [ -z "$arg" ]; then
      for rt in $(columns); do echo "== $rt =="; pin_column "$rt"; done
    else pin_column "$arg"; fi ;;
  *) echo "usage: poly {list | run <col>|all | build <col> | pin <col>|all}" >&2; exit 1 ;;
esac
